@model SaveRoom.Models.JogoPerfil

<!DOCTYPE html>
<html lang="pt-BR">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">


<title>@Model.Name — Saveroom</title>
<meta name="description" content="Detalhes, avaliações e informações sobre @Model.Name.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600&family=Zilla+Slab:wght@500;600;700&display=swap" rel="stylesheet">

<link rel="stylesheet" href="~/css/style.css">
<link rel="stylesheet" href="~/css/jogoperfil.css">

</head>

<body>
<a class="pular" href="#conteudo">Pular para o conteúdo</a>

<header class="topo">
  <div class="faixa">
    <a class="marca" asp-controller="Home" asp-action="Index" aria-label="Saveroom, página inicial">
      <span class="marca-icone" aria-hidden="true"></span>
      <span class="marca-nome">Saveroom</span>
    </a>
    <button class="menu-botao" id="menuBotao" aria-expanded="false" aria-controls="navegacao">
      <span class="menu-barras" aria-hidden="true"></span>
      Menu
    </button>
    <nav class="navegacao" id="navegacao">
      <ul class="nav-lista">
        <li><a href="/#colecao">Minha coleção</a></li>
        <li><a href="/#catalogo">Catálogo</a></li>
        <li><a href="/#avaliacoes">Avaliações</a></li>
        <li><a asp-controller="Usuario" asp-action="Perfil">Perfil</a></li>
      </ul>
      <div class="nav-acoes">
          @if (User.Identity != null && User.Identity.IsAuthenticated)
          {
            <span class="botao botao-fantasma">@User.Identity.Name</span>
            <form asp-controller="Auth" asp-action="Logout" method="post">
                <button type="submit" class="botao botao-cheio">Sair</button>
            </form>
          }
          else
          {
            <a class="botao botao-fantasma" asp-controller="Auth" asp-action="Login">Entrar</a>
            <a class="botao botao-cheio" asp-controller="Auth" asp-action="Cadastro">Criar conta</a>
          }
      </div>
    </nav>
  </div>
</header>

<main id="conteudo">
  <section class="pagina-jogo">
    
    <aside class="jogo-coluna-esq">
      <div class="jogo-poster-box">
        <!-- Imagem e Alt dinâmicos -->
        <img src="@Model.Background_Image" alt="Capa do jogo @Model.Name" class="jogo-poster-img">
        <div class="jogo-acoes">
          @if (User.Identity != null && User.Identity.IsAuthenticated)
          {
            <!-- Armazenar dados necessários para o JavaScript -->
            <input type="hidden" id="hdnIdPerfil" value="@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value" />
            <input type="hidden" id="hdnNomeJogo" value="@Model.Name" />

            <button type="button" id="btnAdicionarColecao" class="botao botao-cheio botao-grande">Adicionar à Coleção</button>
          }
          else
          {   
            <a asp-controller="Auth" asp-action="Login" class="botao botao-cheio botao-grande" style="text-align: center;">Faça login para adicionar</a>
          }
        </div>

        <!-- Div para mensagens de feedback -->
        <div id="mensagemFeedback" style="margin-top: 10px; display: none;"></div>
      </div>

      <div class="jogo-bloco">
        <h2 class="jogo-bloco-titulo">Descrição / Resumo</h2>
        <p class="jogo-texto">
          <!-- Descrição dinâmica vinda da RAWG -->
          @Model.Description_Raw
        </p>
      </div>

      <div class="jogo-bloco">
        <h2 class="jogo-bloco-titulo">Info do Jogo</h2>
        <dl class="jogo-info-lista">
          
          <dt>Lançamento</dt>
          <dd>@(string.IsNullOrEmpty(Model.Released) ? "Data desconhecida" : Model.Released)</dd>

          <dt>Média da Comunidade</dt>
          <dd class="jogo-info-nota">
            @if(Model.Rating > 0)
            {
                @Model.Rating
            }
            else
            {
                <span>Sem nota</span>
            }
          </dd>
        </dl>
      </div>
    </aside>

    <div class="jogo-coluna-dir">
      
      <div class="jogo-cabecalho">
        <!-- Nome do Jogo -->
        <h1>@Model.Name</h1>
      </div>

     <div class="jogo-midia-destaque">
        <!-- Imagem secundaria do jogo -->
        <div class="jogo-midia-placeholder">
    
          @if (!string.IsNullOrEmpty(Model.Background_Image_Additional))
          {
            <img src="@Model.Background_Image_Additional" alt="Gameplay ou arte conceitual de @Model.Name">
          }
          else
          {
            <img src="@Model.Background_Image" alt="Screenshot do jogo @Model.Name">
          }
    
    <span class="jogo-badge-visual">Midia do jogo</span>
  </div>
</div>

      <div class="jogo-grade-inferior">

        <div class="jogo-bloco">
          <h2 class="jogo-bloco-titulo">Voz da Comunidade (Reddit)</h2>
          <div class="jogo-lista-avaliacoes">
    
            @if(Model.PostsDaComunidade != null && Model.PostsDaComunidade.Any())
            {
                @foreach (var post in Model.PostsDaComunidade.Take(3)) 
                {
                    <div class="avaliacao-simples">
                      <div class="avaliacao-topo">
                        <span class="avaliacao-autor" style="color: var(--ambar);">@post.Username</span>
                        <a href="@post.Url" target="_blank" class="nota" style="font-size: 0.75rem; text-decoration: none;">Ver Post</a>
                    </div>
                    <!-- Título do post como texto da avaliação -->
                    <p>@post.Name</p>
                    </div>
                    <hr class="jogo-linha-divisoria">
                }
            }
            else
            {
              <p class="jogo-texto">Nenhuma discussão encontrada para este jogo.</p>
            }

          </div>
        </div>

        <div class="jogo-bloco">
            <h2 class="jogo-bloco-titulo">Onde Jogar / Plataformas</h2>
            <ul class="jogo-plataformas">
    
            @if(Model.Platforms != null && Model.Platforms.Any())
            {
                @foreach (var item in Model.Platforms)
                {
                    <li class="plataforma-tag">@item.Platform.Name</li>
                }
            } 
            else
            {
                <li class="plataforma-tag">Plataformas não informadas</li>
            }

          </ul>
        </div>

        <div class="jogo-bloco jogo-bloco-destaque">
          <h2 class="jogo-bloco-titulo" style="text-align: center;">Avaliações da Comunidade</h2>
          <div style="text-align: center; margin-top: 16px;">
            <p style="font-size: 2.5rem; color: var(--ambar); font-family: var(--fonte-titulo); font-weight: 700;">@Model.Rating</p>
            <p class="jogo-texto" style="font-size: 0.85rem; margin-bottom: 16px;">nota geral no RAWG</p>
          </div>
        </div>

      </div>
    </div>

  </section>
</main>

<footer class="rodape">
  <div class="rodape-faixa">
    <p class="rodape-marca">Saveroom</p>
    <p class="rodape-info">Projeto acadêmico. Informações de jogos obtidas pela API RAWG.</p>
    <ul class="rodape-links">
      <li><a href="/#catalogo">Catálogo</a></li>
      <li><a href="/#avaliacoes">Avaliações</a></li>
      <li><a asp-controller="Usuario" asp-action="Perfil">Perfil</a></li>
    </ul>
  </div>
</footer>
<script src="~/js/script.js"></script>

<!-- Adicionar Jogo ao perfil -->

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const btnAdicionar = document.getElementById('btnAdicionarColecao');
            const mensagemFeedback = document.getElementById('mensagemFeedback');

            if (btnAdicionar) {
                btnAdicionar.addEventListener('click', async function () {
                    // 1. Coletar os dados
                    const idPerfilStr = document.getElementById('hdnIdPerfil').value;
                    const nomeJogo = document.getElementById('hdnNomeJogo').value;
                    
                    // Validação simples
                    if (!idPerfilStr || !nomeJogo) {
                        mostrarMensagem("Erro: Informações incompletas para adicionar ao backlog.", "vermelho");
                        return;
                    }

                    const idPerfil = parseInt(idPerfilStr, 10);

                    // 2. Montar o DTO
                    const dto = {
                        idPerfil: idPerfil,
                        nomeJogo: nomeJogo,
                        status: "a_jogar" // Status padrão definido no DTO
                    };

                    try {
                        // 3. Fazer a requisição POST para a API
                        const resposta = await fetch('/api/Backlog/adicionar', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                            },
                            body: JSON.stringify(dto)
                        });

                        const dados = await resposta.json();

                        // 4. Lidar com a resposta
                        if (resposta.ok) {
                            mostrarMensagem(dados.mensagem || "Jogo adicionado com sucesso!", "verde");
                            btnAdicionar.innerText = "Na Coleção";
                            btnAdicionar.disabled = true;
                        } else {
                            mostrarMensagem(dados.mensagem || "Erro ao adicionar o jogo.", "vermelho");
                        }
                    } catch (erro) {
                        console.error("Erro na requisição:", erro);
                        mostrarMensagem("Erro de comunicação com o servidor.", "vermelho");
                    }
                });
            }

            // Função auxiliar para exibir feedback ao usuário
            function mostrarMensagem(texto, cor) {
                mensagemFeedback.innerText = texto;
                mensagemFeedback.style.color = cor === "verde" ? "green" : "red";
                mensagemFeedback.style.display = "block";
            }
        });
    </script>
}

</body>
</html>
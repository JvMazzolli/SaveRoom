@using System.Security.Claims
@{
    ViewData["Title"] = "SAVEROOM - Perfil";
    Layout = null;
    var usuarioIdLogado = User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "";
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/perfil.css" asp-append-version="true">
</head>
<body>
    <!-- NAVBAR -->
    <header class="navbar">
        <h1 class="logo">SAVEROOM</h1>
        <nav>
            <ul>
                <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li><a asp-controller="Jogo" asp-action="Index">Catálogo</a></li>
                <li><a asp-controller="Jogo" asp-action="MinhaColecao">Minha Coleção</a></li>
                <li><a asp-controller="Avaliacao" asp-action="Index">Avaliações</a></li>
                <li><a asp-controller="Usuario" asp-action="Perfil">Perfil</a></li>
            </ul>
        </nav>
    </header>

    <!-- BANNER DO PERFIL -->
    <section class="banner">
        <img id="banner-img" src="" alt="Banner do Perfil">
    </section>

    <!-- CONTAINER PRINCIPAL DO PERFIL (ESTILO STEAM DARK) -->
    <section class="profile-container">
        
        <!-- COLUNA ESQUERDA: AVATAR + CONTEÚDO -->
        <div class="profile-left-column">
            <div class="profile-header-card">
                <div class="avatar-container">
                    <div class="avatar-frame">
                        <img id="avatar" src="" alt="Avatar do usuário">
                    </div>
                </div>
                <div class="profile-user-titles">
                    <h1 id="username">Usuário</h1>
                    <span id="titulo-perfil" class="profile-title">Velha Guarda</span>
                    <div class="profile-details">
                        <span>ID <strong id="user-id"></strong></span>
                    </div>
                </div>

                <!-- WIDGET DE NÍVEL DA CONTA -->
                <div class="account-level-container">
                    <div class="level-badge-header">
                        <span>Nível <strong id="level">1</strong></span>
                        <span class="level-xp-text">XP 450 / 1000</span>
                    </div>
                    <div class="level-bar-background">
                        <div class="level-bar-fill" style="width: 45%;"></div>
                    </div>
                </div>
            </div>

            <!-- BIO E LINKS -->
            <div class="profile-bio-box">
                <h3>Sobre mim</h3>
                <p id="user-bio">Carregando biografia...</p>
                <div class="profile-links">
                    <a href="#" target="_blank">Steam</a>
                    <a href="#" target="_blank">Discord</a>
                </div>
                <button id="manage-profile">Gerenciar Perfil</button>
            </div>
        </div>

        <!-- COLUNA DIREITA: STATUS E ESTATÍSTICAS DA CONTA (ESTILO STEAM) -->
        <div class="profile-right-column">
            <div class="steam-status-box">
                <div class="status-indicator online">On-line</div>
                <span class="status-subtext">Disponível para jogar</span>
            </div>

            <div class="profile-stats-box">
                <h3>Estatísticas da Conta</h3>
                <div class="stat-item">
                    <span class="stat-label">Nível da Conta</span>
                    <span class="stat-value" id="stat-level">1</span>
                </div>
                <div class="stat-item">
                    <span class="stat-label">Total de Conquistas</span>
                    <span class="stat-value" id="stat-achievements">142</span>
                </div>
                <div class="stat-item">
                    <span class="stat-label">Jogos no Backlog</span>
                    <span class="stat-value" id="stat-backlog">28</span>
                </div>
                <div class="stat-item">
                    <span class="stat-label">Jogos Platinados</span>
                    <span class="stat-value" id="stat-platinums">5</span>
                </div>
            </div>

           
            <!-- BLOCO DE INSÍGNIAS (DINÂMICO) -->
            <div class="steam-badges-box">
                <div class="badges-header">
                    <span>Insígnias</span>
                    <span id="badges-count" class="badges-count">0</span>
                </div>
                <div id="badges-row" class="badges-row">
                    <!-- As insígnias conquistadas serão injetadas dinamicamente aqui via JS -->
                    <span style="font-size: 0.8rem; color: var(--secondary);">Carregando insígnias...</span>
                </div>
            </div>
        </div>

    </section>



    <!-- ATIVIDADES RECENTES / BACKLOG -->
    <section class="activities">
        <div class="activities-header">
            <h2>Atividades Recentes</h2>
        </div>
        <div id="activity-list" class="activity-list"></div>
    </section>

    <!-- MODAL DE CONQUISTAS -->
    <div id="modal-conquistas" class="modal-overlay" style="display: none;">
        <div class="steam-modal-container">
            <div class="steam-modal-header">
                <div class="game-title-row">
                    <img id="modal-game-cover" src="" alt="Capa do Jogo">
                    <h2 id="modal-game-name">NOME DO JOGO</h2>
                </div>
                <button class="steam-close-btn" onclick="fecharModalConquistas()">&times;</button>
            </div>
            <div class="steam-progress-section">
                <div class="steam-progress-info">
                    <span id="modal-progress-text">0 DE 0 CONQUISTAS ALCANÇADAS</span>
                    <span id="modal-progress-percent">(0%)</span>
                </div>
                <div class="steam-bar-bg">
                    <div id="modal-bar-fill" class="steam-bar-fill" style="width: 0%;"></div>
                </div>
            </div>
            <div class="steam-tabs">
                <button class="steam-tab active">MINHAS CONQUISTAS</button>
                <button class="steam-tab">CONQUISTAS GLOBAIS</button>
            </div>
            <div id="steam-achievements-list" class="steam-achievements-list"></div>
        </div>
    </div>
    <!-- POPUP DE CONQUISTA DESBLOQUEADA (ESTILO STEAM) -->
    <div id="steamAchievementPopup" class="achievement-popup">
        <div class="achievement-icon-container">
            <img id="popupIcon" src="/img/insignias/default.png" alt="Ícone da Conquista">
        </div>
        <div class="achievement-text-content">
            <span class="achievement-unlocked-title">Conquista Desbloqueada</span>
            <h4 id="popupTitle">Nome da Conquista</h4>
            <p id="popupDesc">Descrição curta da conquista.</p>
        </div>
    </div>

    <!-- Passa o ID do usuário logado do C# para o JavaScript -->
    <script>
        const USUARIO_LOGADO_ID = "@usuarioIdLogado";
    </script>
    <script src="~/js/perfil.js" asp-append-version="true"></script>
</body>
</html>